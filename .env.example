# Proveedor de IA: none | gemini | claude
LLM_PROVIDER=none

# Gemini (free tier): clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MIN_INTERVAL_S=4

# Claude (opcional, requiere crédito)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-sonnet-5-5

WHISPER_MODEL=base
TOP_N_SEGMENTS=10
KEEP_K_CLIPS=3

# Publicación: manual | draft (sube al buzón de TikTok) | direct (publica)
TIKTOK_MODE=manual
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY
PUBLISH_PER_RUN=3